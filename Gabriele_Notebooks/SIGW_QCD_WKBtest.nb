Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"time2", "=", 
    RowBox[{"AbsoluteTiming", "[", 
     RowBox[{
      RowBox[{"ndsolWKB", "=", 
       RowBox[{"Quiet", "@", 
        RowBox[{
         RowBox[{"NDSolve", "[", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"\[CapitalPi]", "'"}], "[", "\[Eta]s", "]"}], "+", 
               RowBox[{
                RowBox[{"term2", "[", "\[Eta]s", "]"}], 
                RowBox[{"\[CapitalPi]", "[", "\[Eta]s", "]"}]}], "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"term4", "[", "\[Eta]s", "]"}], 
                  SuperscriptBox["k1", "2"]}], ")"}], 
                RowBox[{"\[CapitalPhi]", "[", "\[Eta]s", "]"}]}]}], "==", 
              "0"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"\[CapitalPhi]", "'"}], "[", "\[Eta]s", "]"}], "==", 
              RowBox[{"\[CapitalPi]", "[", "\[Eta]s", "]"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"\[CapitalPhi]", "[", "\[Eta]WKB", "]"}], "==", 
              RowBox[{"\[CapitalPhi]Fk1", "[", "\[Eta]WKB", "]"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"\[CapitalPi]", "[", "\[Eta]WKB", "]"}], "==", 
              RowBox[{"\[CapitalPhi]pFk1", "[", "\[Eta]WKB", "]"}]}]}], "}"}],
            ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"\[CapitalPhi]", ",", "\[CapitalPi]"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Eta]s", ",", "\[Eta]WKB", ",", "\[Eta]end1"}], "}"}], ",", 
           RowBox[{"Method", "\[Rule]", "\"\<StiffnessSwitching\>\""}], 
           "\[IndentingNewLine]", ",", 
           RowBox[{"PrecisionGoal", "\[Rule]", "WP"}], ",", 
           RowBox[{"AccuracyGoal", "\[Rule]", "WP"}], ",", 
           RowBox[{"WorkingPrecision", "\[Rule]", "WP"}], 
           "\[IndentingNewLine]", ",", 
           RowBox[{"MaxSteps", "\[Rule]", "mxstpsize"}]}], 
          "\[IndentingNewLine]", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalPhi]Fk1WKB", "[", "\[Eta]_", "]"}], ":=", 
   RowBox[{
    RowBox[{"\[CapitalPhi]", "[", "\[Eta]", "]"}], "/.", "ndsolWKB"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalPhi]pFk1WKB", "[", "\[Eta]_", "]"}], ":=", 
    RowBox[{
     RowBox[{"\[CapitalPi]", "[", "\[Eta]", "]"}], "/.", "ndsolWKB"}]}], 
   ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Here", " ", "WKB", " ", "approximation", " ", "Initial", " ", 
    "conditions"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Phi0", "=", 
   RowBox[{"\[CapitalPhi]Fk1", "[", "\[Eta]WKB", "]"}]}], ";", 
  RowBox[{"Pi0", "=", 
   RowBox[{"\[CapitalPhi]pFk1", "[", "\[Eta]WKB", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S1", "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"term4", "[", "\[Eta]WKB", "]"}], "]"}]}], ";", 
  RowBox[{"A0", "=", 
   RowBox[{"1", "/", 
    RowBox[{
     RowBox[{"term4", "[", "\[Eta]WKB", "]"}], "^", 
     RowBox[{"(", 
      RowBox[{"1", "/", "4"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Cplus", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Phi0", "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "A0"}], ")"}]}], ")"}], "+", 
     RowBox[{"(", 
      RowBox[{"Pi0", "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "I", " ", "k1", " ", "S1", " ", "A0"}], ")"}]}], 
      ")"}]}]}], ";", 
   RowBox[{"Cminus", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Phi0", "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "A0"}], ")"}]}], ")"}], "-", 
     RowBox[{"(", 
      RowBox[{"Pi0", "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "I", " ", "k1", " ", "S1", " ", "A0"}], ")"}]}], 
      ")"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"time3", "=", 
    RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"intTerm2", "=", 
       RowBox[{"NDSolveValue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
