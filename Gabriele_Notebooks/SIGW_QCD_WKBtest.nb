Cell[BoxData[{
 RowBox[{
  RowBox[{"solbkg", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"\[Rho]", "'"}], "[", "\[Eta]", "]"}], "==", 
        RowBox[{
         RowBox[{"-", "3"}], 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"wnT", "[", "\[Eta]", "]"}]}], ")"}], 
         FractionBox[
          RowBox[{
           RowBox[{"a", "'"}], "[", "\[Eta]", "]"}], 
          RowBox[{"a", "[", "\[Eta]", "]"}]], 
         RowBox[{"\[Rho]", "[", "\[Eta]", "]"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
