Cell["WKB approximation", "Subsubsection",
 CellChangeTimes->{{3.965262400828622*^9, 
  3.965262406766254*^9}},ExpressionUUID->"2a70cf1c-2a78-4b48-bd88-\
6a80e8e470dd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "ComputePhiWKB", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ComputePhiWKB", "[", 
   RowBox[{"k1_", ",", "print_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[CapitalPhi]Fk1", ",", "\[CapitalPhi]pFk1", ",", "ndsolk1", ",", 
      "\[Phi]sol1", ",", 
      RowBox[{"mxstpsize", "=", 
       SuperscriptBox["10", "7"]}], 
      RowBox[{"(*", 
       RowBox[{
        SuperscriptBox["10", "7"], " ", "-", " ", 
        RowBox[{"works", " ", "for", " ", "RD"}]}], "*)"}], ",", 
      RowBox[{"WP", "=", "15"}], 
      RowBox[{"(*", 
       RowBox[{"15", " ", "-", " ", 
        RowBox[{"works", " ", "for", " ", "RD"}]}], "*)"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Eta]inI1", "=", 
       RowBox[{
        SuperscriptBox["10", 
         RowBox[{"-", "2."}]], "/", "k1"}]}], ",", 
      RowBox[{"\[Eta]end1", "=", 
       RowBox[{
        RowBox[{"10", "^", "3"}], "/", "k1"}]}], ",", 
      RowBox[{"\[Eta]WKB", "=", 
       RowBox[{
        RowBox[{"10", "^", "2"}], "/", "k1"}]}], ",", "\[IndentingNewLine]", 
      "ndsolWKB", ",", "\[CapitalPhi]Fk1WKB", ",", "\[CapitalPhi]pFk1WKB", ",",
       "tabWKB", ",", "WKBsol", ",", "S1", ",", "A0", ",", "Phi0", ",", "Pi0",
       ",", "Cplus", ",", "Cminus", ",", "Phi", ",", "etas", ",", "intTerm2", 
      ",", "intSqrtTerm4", ",", "time1", ",", "time2", ",", "time3"}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"time1", "=", 
      RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ndsolk1", "=", 
         RowBox[{"Quiet", "@", 
          RowBox[{
           RowBox[{"NDSolve", "[", 
            RowBox[{
             RowBox[{"{", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"\[CapitalPi]", "'"}], "[", "\[Eta]s", "]"}], "+", 
                 RowBox[{
                  RowBox[{"term2", "[", "\[Eta]s", "]"}], 
                  RowBox[{"\[CapitalPi]", "[", "\[Eta]s", "]"}]}], "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"term4", "[", "\[Eta]s", "]"}], 
                    SuperscriptBox["k1", "2"]}], "+", 
                    RowBox[{"term3", "[", "\[Eta]s", "]"}]}], ")"}], 
                  RowBox[{"\[CapitalPhi]", "[", "\[Eta]s", "]"}]}]}], "==", 
                "0"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"\[CapitalPhi]", "'"}], "[", "\[Eta]s", "]"}], "==", 
                
                RowBox[{"\[CapitalPi]", "[", "\[Eta]s", "]"}]}], ",", 
               RowBox[{
                RowBox[{"\[CapitalPhi]", "[", "\[Eta]inI1", "]"}], "==", 
                "1"}], ",", 
               RowBox[{
                RowBox[{"\[CapitalPi]", "[", "\[Eta]inI1", "]"}], "==", 
                "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"\[CapitalPhi]", ",", "\[CapitalPi]"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"\[Eta]s", ",", "\[Eta]inI1", ",", "\[Eta]end1"}], 
              "}"}], "\[IndentingNewLine]", ",", 
             RowBox[{"Method", "\[Rule]", "\"\<StiffnessSwitching\>\""}], 
             "\[IndentingNewLine]", ",", 
             RowBox[{"PrecisionGoal", "\[Rule]", "WP"}], ",", 
             RowBox[{"AccuracyGoal", "\[Rule]", "WP"}], ",", 
             RowBox[{"WorkingPrecision", "\[Rule]", "WP"}], 
             "\[IndentingNewLine]", ",", 
             RowBox[{"MaxSteps", "\[Rule]", "mxstpsize"}]}], 
            "\[IndentingNewLine]", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[CapitalPhi]Fk1", "[", "\[Eta]_", "]"}], ":=", 
      RowBox[{
       RowBox[{"\[CapitalPhi]", "[", "\[Eta]", "]"}], "/.", "ndsolk1"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[CapitalPhi]pFk1", "[", "\[Eta]_", "]"}], ":=", 
      RowBox[{
       RowBox[{"\[CapitalPi]", "[", "\[Eta]", "]"}], "/.", "ndsolk1"}]}], ";",
      "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"time2", "=", 
      RowBox[{"AbsoluteTiming", "[", 
       RowBox[{
        RowBox[{"ndsolWKB", "=", 
         RowBox[{"Quiet", "@", 
          RowBox[{
           RowBox[{"NDSolve", "[", 
            RowBox[{
             RowBox[{"{", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"\[CapitalPi]", "'"}], "[", "\[Eta]s", "]"}], "+", 
                 RowBox[{
                  RowBox[{"term2", "[", "\[Eta]s", "]"}], 
                  RowBox[{"\[CapitalPi]", "[", "\[Eta]s", "]"}]}], "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"term4", "[", "\[Eta]s", "]"}], 
                    SuperscriptBox["k1", "2"]}], ")"}], 
                  RowBox[{"\[CapitalPhi]", "[", "\[Eta]s", "]"}]}]}], "==", 
                "0"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"\[CapitalPhi]", "'"}], "[", "\[Eta]s", "]"}], "==", 
                
                RowBox[{"\[CapitalPi]", "[", "\[Eta]s", "]"}]}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"\[CapitalPhi]", "[", "\[Eta]WKB", "]"}], "==", 
                RowBox[{"\[CapitalPhi]Fk1", "[", "\[Eta]WKB", "]"}]}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"\[CapitalPi]", "[", "\[Eta]WKB", "]"}], "==", 
                RowBox[{"\[CapitalPhi]pFk1", "[", "\[Eta]WKB", "]"}]}]}], 
              "}"}], ",", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"\[CapitalPhi]", ",", "\[CapitalPi]"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"\[Eta]s", ",", "\[Eta]WKB", ",", "\[Eta]end1"}], "}"}],
              ",", 
             RowBox[{"Method", "\[Rule]", "\"\<StiffnessSwitching\>\""}], 
             "\[IndentingNewLine]", ",", 
             RowBox[{"PrecisionGoal", "\[Rule]", "WP"}], ",", 
             RowBox[{"AccuracyGoal", "\[Rule]", "WP"}], ",", 
             RowBox[{"WorkingPrecision", "\[Rule]", "WP"}], 
             "\[IndentingNewLine]", ",", 
             RowBox[{"MaxSteps", "\[Rule]", "mxstpsize"}]}], 
            "\[IndentingNewLine]", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[CapitalPhi]Fk1WKB", "[", "\[Eta]_", "]"}], ":=", 
      RowBox[{
       RowBox[{"\[CapitalPhi]", "[", "\[Eta]", "]"}], "/.", "ndsolWKB"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[CapitalPhi]pFk1WKB", "[", "\[Eta]_", "]"}], ":=", 
      RowBox[{
       RowBox[{"\[CapitalPi]", "[", "\[Eta]", "]"}], "/.", "ndsolWKB"}]}], ";",
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Initial", " ", "conditions"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Phi0", "=", 
      RowBox[{"\[CapitalPhi]Fk1", "[", "\[Eta]WKB", "]"}]}], ";", 
     RowBox[{"Pi0", "=", 
      RowBox[{"\[CapitalPhi]pFk1", "[", "\[Eta]WKB", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"S1", "=", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"term4", "[", "\[Eta]WKB", "]"}], "]"}]}], ";", 
     RowBox[{"A0", "=", 
      RowBox[{"1", "/", 
       RowBox[{
        RowBox[{"term4", "[", "\[Eta]WKB", "]"}], "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", "4"}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Cplus", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Phi0", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "A0"}], ")"}]}], ")"}], "+", 
       RowBox[{"(", 
        RowBox[{"Pi0", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "I", " ", "k1", " ", "S1", " ", "A0"}], ")"}]}], 
        ")"}]}]}], ";", 
     RowBox[{"Cminus", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Phi0", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "A0"}], ")"}]}], ")"}], "-", 
       RowBox[{"(", 
        RowBox[{"Pi0", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "I", " ", "k1", " ", "S1", " ", "A0"}], ")"}]}], 
        ")"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Define", " ", "grid", " ", "for", " ", "eta"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"etas", "=", 
      RowBox[{"10", "^", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"Log10", "@", "\[Eta]WKB"}], ",", 
         RowBox[{"Log10", "@", "\[Eta]end1"}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Log10", "@", "\[Eta]end1"}], "-", 
            RowBox[{"Log10", "@", "\[Eta]WKB"}]}], ")"}], "/", 
          RowBox[{"10", "^", "4"}]}]}], "]"}]}]}], ";", "\n", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"##", "##", "##", "##", " ", "Brute"}], "-", 
        RowBox[{"force", " ", "approach", " ", "##", "##", "##", "##"}]}], 
       " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Phi", "[", "eta_", "]"}], ":=", 
        RowBox[{
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"1", "/", "2"}], ")"}]}], " ", 
            RowBox[{"Quiet", "@", 
             RowBox[{"NIntegrate", "[", 
              RowBox[{
               RowBox[{"term2", "[", "t", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"t", ",", "\[Eta]WKB", ",", "eta"}], "}"}]}], 
              "]"}]}]}], "]"}], "/", 
          RowBox[{
           RowBox[{"term4", "[", "eta", "]"}], "^", 
           RowBox[{"(", 
            RowBox[{"1", "/", "4"}], ")"}]}]}], "*", "\[IndentingNewLine]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Cplus", " ", 
            RowBox[{"Exp", "[", 
             RowBox[{"I", " ", "k1", " ", 
              RowBox[{"Quiet", "@", 
               RowBox[{"NIntegrate", "[", 
                RowBox[{
                 RowBox[{"Sqrt", "[", 
                  RowBox[{"term4", "[", "t", "]"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"t", ",", "\[Eta]WKB", ",", "eta"}], "}"}]}], 
                "]"}]}]}], "]"}]}], "+", 
           RowBox[{"Cminus", " ", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "I"}], " ", "k1", " ", 
              RowBox[{"Quiet", "@", 
               RowBox[{"NIntegrate", "[", 
                RowBox[{
                 RowBox[{"Sqrt", "[", 
                  RowBox[{"term4", "[", "t", "]"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"t", ",", "\[Eta]WKB", ",", "eta"}], "}"}]}], 
                "]"}]}]}], "]"}]}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"tabWKB", "=", 
        RowBox[{"ParallelTable", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"eta", ",", 
            RowBox[{"Re", "@", 
