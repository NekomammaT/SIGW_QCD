Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "ComputePhiWKB", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ComputeI", "[", 
   RowBox[{"k1_", ",", "k2_", ",", "k_", ",", "print_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[CapitalPhi]Fk1", ",", "\[CapitalPhi]pFk1", ",", "ndsolk1", ",", 
      "\[CapitalPhi]Fk2", ",", "\[CapitalPhi]pFk2", ",", "ndsolk2", ",", 
      "g1k", ",", "g2k", ",", "G1k", ",", "G2k", ",", "ndsolg2", ",", 
      "ndsolg1", ",", 
      RowBox[{"mxstpsize", "=", 
       SuperscriptBox["10", "7"]}], 
      RowBox[{"(*", 
       RowBox[{
        SuperscriptBox["10", "7"], " ", "-", " ", 
        RowBox[{"works", " ", "for", " ", "RD"}]}], "*)"}], ",", 
      RowBox[{"WP", "=", "15"}], 
      RowBox[{"(*", 
       RowBox[{"15", " ", "-", " ", 
        RowBox[{"works", " ", "for", " ", "RD"}]}], "*)"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Eta]inI1", "=", 
       RowBox[{
        SuperscriptBox["10", 
         RowBox[{"-", "2."}]], "/", "k1"}]}], ",", 
      RowBox[{"\[Eta]end1", "=", 
       RowBox[{
        RowBox[{"10", "^", "3"}], "/", "k1"}]}], ",", 
      RowBox[{"\[Eta]WKB1", "=", 
       RowBox[{
        RowBox[{"10", "^", "2"}], "/", "k1"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"\[Eta]inI2", "=", 
       RowBox[{
        SuperscriptBox["10", 
         RowBox[{"-", "2."}]], "/", "k2"}]}], ",", 
      RowBox[{"\[Eta]end2", "=", 
       RowBox[{
        RowBox[{"10", "^", "3"}], "/", "k2"}]}], ",", 
      RowBox[{"\[Eta]WKB2", "=", 
       RowBox[{
        RowBox[{"10", "^", "2"}], "/", "k2"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"\[Eta]inI", "=", 
       RowBox[{
        SuperscriptBox["10", 
         RowBox[{"-", "2."}]], "/", "k"}]}], ",", 
      RowBox[{"\[Eta]end", "=", 
       RowBox[{
        RowBox[{"10", "^", "3"}], "/", "k"}]}], ",", 
      RowBox[{"\[Eta]WKB", "=", 
       RowBox[{
        RowBox[{"10", "^", "2"}], "/", "k"}]}], ",", "\[IndentingNewLine]", 
      "WKBsol1", ",", "WKBsol1prime", ",", "S11", ",", "A01", ",", "Phi10", ",",
       "Pi10", ",", "Cplus1", ",", "Cminus1", ",", "\[IndentingNewLine]", 
      "WKBsol2", ",", "WKBsol2prime", ",", "S12", ",", "A02", ",", "Phi20", ",",
       "Pi20", ",", "Cplus2", ",", "Cminus2", ",", "\[IndentingNewLine]", 
      "Phi", ",", "etas", ",", "intTerm21", ",", "intSqrtTerm41", ",", 
      "intTerm22", ",", "intSqrtTerm42", ",", "\[IndentingNewLine]", 
      "intSqrtKminusTerm1", ",", "g10", ",", "G10", ",", "g20", ",", "G20", ",",
       "S1", ",", "A1", ",", "C1plus", ",", "C1minus", ",", "C2plus", ",", 
      "C2minus", ",", "g1WKB", ",", "G1WKB", ",", "g2WKB", ",", "G2WKB"}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ndsolk1", "=", 
      RowBox[{"Quiet", "@", 
       RowBox[{
        RowBox[{"NDSolve", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"\[CapitalPi]", "'"}], "[", "\[Eta]s", "]"}], "+", 
              RowBox[{
               RowBox[{"term2", "[", "\[Eta]s", "]"}], 
               RowBox[{"\[CapitalPi]", "[", "\[Eta]s", "]"}]}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"term4", "[", "\[Eta]s", "]"}], 
                  SuperscriptBox["k1", "2"]}], "+", 
                 RowBox[{"term3", "[", "\[Eta]s", "]"}]}], ")"}], 
               RowBox[{"\[CapitalPhi]", "[", "\[Eta]s", "]"}]}]}], "==", 
             "0"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"\[CapitalPhi]", "'"}], "[", "\[Eta]s", "]"}], "==", 
             RowBox[{"\[CapitalPi]", "[", "\[Eta]s", "]"}]}], ",", 
            RowBox[{
             RowBox[{"\[CapitalPhi]", "[", "\[Eta]inI1", "]"}], "==", "1"}], ",", 
            RowBox[{
             RowBox[{"\[CapitalPi]", "[", "\[Eta]inI1", "]"}], "==", "0"}]}], 
           "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"\[CapitalPhi]", ",", "\[CapitalPi]"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\[Eta]s", ",", "\[Eta]inI1", ",", "\[Eta]end1"}], "}"}], ",", 
