Cell[CellGroupData[{

Cell["6. Checks", "Section",ExpressionUUID->"8558ce6e-4974-44d9-8e32-46a2c093ff40"],

Cell["\<\
The kernel tables only cover t <= 3000, so the flat spectrum is truncated at \
large t. Below: Omega_GW(flat) for one kernel as the upper limit t_cut is \
varied.\
\>", "Text",ExpressionUUID->"9f4d5d7e-2b80-40af-9bf7-ebfefaa90b95"],

Cell[CellGroupData[{

Cell["\<\
tCutCheck[i_] := Module[{ker = kernels[[i]], out},
   Table[Module[{m = Flatten @ Position[ker[\"t\"], _?(# <= tc &)], kc},
     kc = <|\"f\" -> ker[\"f\"], \"k\" -> ker[\"k\"], \"s\" -> ker[\"s\"], \
\"t\" -> ker[\"t\"][[m]], \"I2\" -> ker[\"I2\"][[m]]|>;
     {tc, omegaGW[kc[\"k\"], phKernel[kc, flatPz]]}], {tc, {10., 30., 100., \
300., 1000., 3000.}}]];
{kernels[[60]][\"f\"], tCutCheck[60]}\
\>", "Input",
 CellLabel->
  "In[145]:=",ExpressionUUID->"6c477492-9060-46bc-b246-0b1abf950e29"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"6.151638774609209`", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"10.`", ",", "0.5083377255587319`"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"30.`", ",", "0.5157188602201471`"}], "}"}], ",", 
     RowBox[{"{", 
