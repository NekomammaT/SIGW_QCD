Cell[CellGroupData[{

Cell["\<\
Manipulate[
  Module[{pz = lognormalPz[fnHzToK[10^lf], sg], om},
   om = Table[omegaGW[ker[\"k\"], phKernel[ker, pz]], {ker, kernels}];
   ListLogLogPlot[{Transpose[{fList, omFlat}], Transpose[{fList, om}]}, \
Joined -> True, PlotRange -> All,
    Frame -> True, FrameLabel -> {\"f [nHz]\", \"Omega_GW h^2 / (Omega_r0 h^2 \
A^2)\"},
    PlotLegends -> {\"flat\", \"log-normal\"}, ImageSize -> 450]],
  {{lf, 1.}, -2., 4., 0.1, Appearance -> \"Labeled\"}, {{sg, 0.4}, 0.1, 1.5, \
0.05, Appearance -> \"Labeled\"},
  TrackedSymbols :> {lf, sg}]\
\>", "Input",
 CellLabel->
  "In[144]:=",ExpressionUUID->"0928fdde-14c4-446f-9826-e813f86fa7fd"],

